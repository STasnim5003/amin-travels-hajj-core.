version: "3.9"

services:
  web:
    build: .
    container_name: amin-travels-hajj
    network_mode: host
    env_file:
      - .env
    volumes:
      - .:/app
    restart: always

version: "3.9"

services:
  web:
    build: .
    container_name: amin-travels-hajj
    ports:
      - "0.0.0.0:8000:8000"
    env_file:
      - .env
    volumes:
      - .:/app
    restart: always
